# .env.example — cópialo a /opt/gastos/.env en el servidor (chmod 600) y rellénalo. NUNCA en git con valores.
# python -c "import secrets; print(secrets.token_urlsafe(50))"  → para cada clave y contraseña

# ── Despliegue ──
VERSION=latest
GHCR_OWNER=tu-usuario
DOMINIO=gastos.example.com
ACME_EMAIL=tu@email.com

# ── Django ──
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
# Al rotar la clave: la anterior aquí (separadas por comas) unos días; luego, vacío (runbook)
DJANGO_SECRET_KEY_FALLBACKS=
JWT_SIGNING_KEY=
DJANGO_ALLOWED_HOSTS=gastos.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://gastos.example.com
FRONTEND_URL=https://gastos.example.com
SECURE_HSTS_SECONDS=3600
LOG_FORMAT=json

# ── PostgreSQL ──
POSTGRES_DB=gastos
POSTGRES_USER=gastos
POSTGRES_PASSWORD=
DATABASE_URL=postgres://gastos:LA_MISMA_CONTRASEÑA@db:5432/gastos

# ── Redis y RabbitMQ ──
REDIS_URL=redis://redis:6379/1
REDIS_CHANNELS_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/0
RABBITMQ_USER=gastos
RABBITMQ_PASSWORD=
CELERY_BROKER_URL=amqp://gastos:LA_MISMA_CONTRASEÑA@rabbitmq:5672//

# ── Archivos: Cloudflare R2 (o cualquier S3) ──
S3_BUCKET=gastos
S3_ENDPOINT_URL=https://ID_DE_CUENTA.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Correo (Brevo, Resend, SES…: módulo 68) ──
DEFAULT_FROM_EMAIL='"Gastos" <no-responder@gastos.example.com>'
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── IA (Gemini por defecto, módulo 74) ──
IA_API_KEY=
IA_MODELO=gemini-3.8-flash

# ── Observabilidad (módulo 30) ──
SENTRY_DSN=
