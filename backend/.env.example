# Copia este archivo a .env (cp .env.example .env). Valores SOLO para desarrollo.
DJANGO_SECRET_KEY=dev-no-usar-en-produccion
JWT_SIGNING_KEY=dev-jwt-clave-larga-de-al-menos-32-bytes-no-usar-en-produccion
# Módulo 92: la clave que cifra los secretos TOTP (en staging y producción, una propia: manage.py generar_clave_mfa)
MFA_CLAVES=ZGV2LW5vLXVzYXItZW4tcHJvZHVjY2lvbi0wMTIzNDU=
DATABASE_URL=postgres://gastos:gastos@localhost:5432/gastos
IA_API_KEY=
# IA_BASE_URL=http://localhost:11434/v1/   IA_MODELO=<modelo multimodal>   IA_API_KEY=ollama   (alternativa local)
# Módulo 90 (authorization server): la clave que firma los ID tokens. uv run python manage.py generar_clave_oidc >> .env
# Módulo 91 (social login): con el proveedor falso de compose.yaml (docker compose up -d oidc), "Google" en local:
# GOOGLE_CLIENT_ID=gastos-local
# GOOGLE_CLIENT_SECRET=gastos-local
# GOOGLE_EMISOR=http://localhost:8089/google
