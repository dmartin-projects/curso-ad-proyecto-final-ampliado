{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci",
  "buildCommand": "npx ng build --configuration production",
  "outputDirectory": "dist/gastos/browser",
  "git": { "deploymentEnabled": false },
  "routes": [
    {
      "src": "^/(api|estadisticas|\\.well-known/(?:oauth-protected-resource|oauth-authorization-server|openid-configuration))/(.*)$",
      "dest": "${API_ORIGEN}/$1/$2",
      "env": ["API_ORIGEN"],
      "headers": { "x-vercel-enable-rewrite-caching": "0" },
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-origen-vercel" },
          "args": "${ORIGEN_SECRETO}",
          "env": ["ORIGEN_SECRETO"]
        }
      ]
    },
    {
      "src": "^/(.*)$",
      "headers": {
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "same-origin",
        "X-Frame-Options": "DENY",
        "Permissions-Policy": "geolocation=(), microphone=()",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; worker-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' wss://api.gastos.tudominio.com wss://api.staging.gastos.tudominio.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "^/.*-[0-9A-Za-z_-]{8}\\.(?:js|css|woff2?)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "^/.*-[0-9A-Za-z_-]{8}\\.(?:js|css|woff2?)$",
      "status": 404,
      "headers": { "Cache-Control": "no-store" }
    },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
