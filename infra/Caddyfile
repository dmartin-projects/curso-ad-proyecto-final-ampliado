# infra/Caddyfile — la puerta de la VM (módulos 65, 83 y 86): SOLO la API, para los dos entornos
# Angular ya no está aquí (lo sirve Vercel). Cada entorno se registra con su edge.env, que escribe
# desplegar.sh: API_HOST_PRODUCCION, ORIGEN_SECRETO_PRODUCCION, API_HOST_STAGING, ORIGEN_SECRETO_STAGING.
# Un entorno que aún no existe se queda en un host .invalid solo HTTP (sin pedir certificados).
{
	{$CADDY_GLOBAL}
	email {$ACME_EMAIL}
}

# args[0]: la web (Django) del entorno; args[1]: su servicio de estadísticas; args[2]: el secreto de Vercel
(api) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}

	request_body {
		max_size 12MB # tickets de hasta 10 MB (módulo 74) + la envoltura multipart
	}

	# /api y /estadisticas, SOLO a través de Vercel: el rewrite añade X-Origen-Vercel con el secreto del
	# entorno. Directo, 403: así la IP de X-Real-IP (la pone Vercel) es de fiar y nadie se salta Vercel.
	@vercel {
		path /api/* /estadisticas/*
		header X-Origen-Vercel {args[2]}
	}
	@directo path /api/* /estadisticas/*

	handle @vercel {
		# Para Django, UNA sola IP: la del navegador (NUM_PROXIES = 1). Sin esto, Caddy añadiría la de
		# Vercel detrás y el throttling contaría a todos los usuarios como uno.
		handle /estadisticas/* {
			reverse_proxy {args[1]} {
				header_up X-Forwarded-For {http.request.header.X-Real-IP}
				header_up -X-Origen-Vercel
			}
		}
		handle {
			reverse_proxy {args[0]} {
				header_up X-Forwarded-For {http.request.header.X-Real-IP}
				header_up X-Request-ID {http.request.uuid}
				header_up -X-Origen-Vercel
			}
		}
	}
	handle @directo {
		respond "La API se usa a traves de la web" 403
	}

	# El WebSocket (Vercel no lo reenvía: el navegador viene directo, módulo 86) y las sondas de salud.
	# X-Forwarded-For: la IP de quien conecta (Caddy ignora la que traiga la petición).
	@abierto path /ws/* /health/*
	handle @abierto {
		reverse_proxy {args[0]} {
			header_up X-Request-ID {http.request.uuid}
		}
	}

	handle {
		respond 404
	}
}

{$API_HOST_PRODUCCION:http://produccion.invalid} {
	import api web-produccion:8000 estadisticas-produccion:8000 {$ORIGEN_SECRETO_PRODUCCION:sin-configurar}
}

{$API_HOST_STAGING:http://staging.invalid} {
	import api web-staging:8000 estadisticas-staging:8000 {$ORIGEN_SECRETO_STAGING:sin-configurar}
}
