# infra/entornos/produccion.env — la configuración NO secreta de producción (módulo 86), en claro y revisable.
# Los secretos están cifrados en infra/secretos/produccion.env (SOPS). El workflow junta los dos en el .env
# de la VM (/opt/gastos/produccion/.env) en cada despliegue: nadie edita el .env del servidor a mano.

# ── El entorno ──
ENTORNO=produccion
COMPOSE_PROJECT_NAME=gastos # el del módulo 83: los mismos volúmenes (y los mismos datos)
COMPOSE_FILE=compose.prod.yaml # "docker compose …" en el directorio del entorno, sin -f
GHCR_OWNER=tu-usuario-de-github
ACME_EMAIL=tu@email.com

# ── Nombres públicos (dominio propio en Hostinger: gastos.tudominio.com → Vercel, api.… → la VM) ──
API_HOST=api.gastos.tudominio.com
FRONTEND_URL=https://gastos.tudominio.com
DJANGO_ALLOWED_HOSTS=api.gastos.tudominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://gastos.tudominio.com
WS_URL=wss://api.gastos.tudominio.com/ws/notificaciones/
WS_ORIGENES=https://gastos.tudominio.com

# ── Django ──
DJANGO_SETTINGS_MODULE=config.settings.prod
SECURE_HSTS_SECONDS=3600
LOG_FORMAT=json

# ── PostgreSQL, Redis y RabbitMQ (en la red privada del entorno) ──
POSTGRES_DB=gastos
POSTGRES_USER=gastos
REDIS_URL=redis://redis:6379/1
REDIS_CHANNELS_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/0
RABBITMQ_USER=gastos

# ── Archivos: Cloudflare R2, un bucket por entorno ──
S3_BUCKET=gastos
S3_ENDPOINT_URL=https://ID_DE_CUENTA.r2.cloudflarestorage.com
S3_REGION=auto

# ── Correo (Resend, desde el subdominio de envío gastos.tudominio.com: módulo 86) e IA ──
DEFAULT_FROM_EMAIL='"Gastos" <avisos@gastos.tudominio.com>'
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
IA_MODELO=gemini-3.8-flash

# ── Eventos (módulo 85) ──
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── OpenTelemetry → Grafana Cloud (módulo 84) ──
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=produccion
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_TRAZA_URL=
