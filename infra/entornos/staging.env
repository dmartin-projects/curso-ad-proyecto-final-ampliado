# infra/entornos/staging.env — la configuración NO secreta de staging (módulo 86), en claro y revisable.
# Los secretos están cifrados en infra/secretos/staging.env (SOPS). El workflow junta los dos en el .env
# de la VM (/opt/gastos/staging/.env) en cada despliegue: nadie edita el .env del servidor a mano.

# ── El entorno ──
ENTORNO=staging
COMPOSE_PROJECT_NAME=gastos-staging # otro proyecto: sus propios contenedores, volúmenes y red
COMPOSE_FILE=compose.prod.yaml # "docker compose …" en el directorio del entorno, sin -f
GHCR_OWNER=tu-usuario-de-github
ACME_EMAIL=tu@email.com

# ── Nombres públicos (dominio propio en Hostinger: gastos.tudominio.com → Vercel, api.… → la VM) ──
API_HOST=api.staging.gastos.tudominio.com
FRONTEND_URL=https://staging.gastos.tudominio.com
DJANGO_ALLOWED_HOSTS=api.staging.gastos.tudominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.gastos.tudominio.com
WS_URL=wss://api.staging.gastos.tudominio.com/ws/notificaciones/
# Módulo 90: el authorization server, en el dominio de la app (Vercel reenvía /api/* a Django)
OAUTH_ISSUER=https://staging.gastos.tudominio.com/api/oauth
WS_ORIGENES=https://staging.gastos.tudominio.com

# Módulo 91: social login. Un cliente por entorno en cada proveedor, con su vuelta registrada EXACTA:
#   https://staging.gastos.tudominio.com/api/v1/auth/social/<google|github|apple|microsoft>/vuelta/
# Sin client_id, ese proveedor no aparece. Los secretos (y la clave .p8 de Apple), en infra/secretos/
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Ejercicio 1: Microsoft Entra ID (cuentas personales y de empresa)
MICROSOFT_CLIENT_ID=

# ── Django ──
DJANGO_SETTINGS_MODULE=config.settings.prod
SECURE_HSTS_SECONDS=3600
LOG_FORMAT=json

# ── PostgreSQL, Redis y RabbitMQ (en la red privada del entorno) ──
POSTGRES_DB=gastos
POSTGRES_USER=gastos
REDIS_URL=redis://redis:6379/1
REDIS_CHANNELS_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/0
RABBITMQ_USER=gastos

# ── Archivos: Cloudflare R2, un bucket por entorno ──
S3_BUCKET=gastos-staging
S3_ENDPOINT_URL=https://ID_DE_CUENTA.r2.cloudflarestorage.com
S3_REGION=auto

# ── Correo (Resend, desde el subdominio de envío gastos.tudominio.com: módulo 86) e IA ──
DEFAULT_FROM_EMAIL='"Gastos (staging)" <avisos@gastos.tudominio.com>'
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
IA_MODELO=gemini-3.8-flash

# ── Eventos (módulo 85) ──
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── OpenTelemetry → Grafana Cloud (módulo 84) ──
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=staging
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_TRAZA_URL=

# ── Solo en staging (módulo 86) ──
# Las previews de Vercel (una por pull request) usan esta API: el WebSocket acepta las de ESTE proyecto y equipo
VERCEL_PREVIEW_PROYECTO=gastos
VERCEL_PREVIEW_EQUIPO=tu-equipo-de-vercel
# Menos memoria que producción (medido en el módulo 86)
KAFKA_HEAP_OPTS="-Xms256m -Xmx256m"
