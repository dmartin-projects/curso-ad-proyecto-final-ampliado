{
  "uid": "asistente",
  "title": "Gastos · asistente",
  "tags": [
    "gastos",
    "asistente"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Coste del asistente (24 h)",
      "description": "Estimado con ASISTENTE_PRECIOS. El de cada hogar, en la base de datos: manage.py coste_asistente",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(gastos_asistente_coste_usd_total[24h]))",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 4
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Preguntas (24 h)",
      "description": "Por cómo terminaron: fin, cancelada, error, respuesta_cortada, limite_iteraciones…",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "round(sum by (gastos_asistente_motivo) (increase(gastos_asistente_preguntas_total[24h])))",
          "legendFormat": "{{gastos_asistente_motivo}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Primer trozo de texto: p95",
      "description": "Lo que la persona mira la pantalla sin ver nada (con streaming; sin él, sería la respuesta entera)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_inference_time_to_first_chunk_seconds_bucket[$__rate_interval])))",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Cuotas agotadas (24 h)",
      "description": "Preguntas rechazadas con un 429: por la cuota de la persona (hoy) o la del hogar (este mes)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "round(sum by (gastos_asistente_cuota) (increase(gastos_asistente_cuota_agotada_total[24h])))",
          "legendFormat": "{{gastos_asistente_cuota}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Tokens por minuto, por modelo",
      "description": "El límite de Groq gratis es por minuto (8.000 en gpt-oss-120b, contando entrada y salida)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (gen_ai_response_model) (rate(gen_ai_client_inference_usage_input_tokens_total[$__rate_interval])) * 60",
          "legendFormat": "entrada · {{gen_ai_response_model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "expr": "sum by (gen_ai_response_model) (rate(gen_ai_client_inference_usage_output_tokens_total[$__rate_interval])) * 60",
          "legendFormat": "salida · {{gen_ai_response_model}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Coste por hora, por modelo",
      "description": "Sin hogares: en las métricas solo hay etiquetas con pocos valores (cardinalidad)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (gen_ai_response_model) (increase(gastos_asistente_coste_usd_total[1h]))",
          "legendFormat": "{{gen_ai_response_model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Duración p95: pregunta entera y cada llamada al modelo",
      "description": "Por el modelo PEDIDO: las llamadas que fallan no tienen modelo de respuesta",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_invoke_agent_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "pregunta",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(gen_ai_client_inference_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "llamada · {{gen_ai_request_model}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Entrada servida desde la caché del proveedor",
      "description": "Prompt caching (módulo 99): el prefijo que se repite (instrucciones, tools) se cobra a mitad de precio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(gen_ai_client_inference_usage_cache_read_input_tokens_total[$__rate_interval])) / sum(rate(gen_ai_client_inference_usage_input_tokens_total[$__rate_interval]))",
          "legendFormat": "caché",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Tools: llamadas por minuto (y las que fallan)",
      "description": "Un error de una tool vuelve al modelo, que se corrige; muchos seguidos, una descripción que confunde (módulo 95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (gen_ai_tool_name) (rate(gen_ai_execute_tool_duration_seconds_count[$__rate_interval])) * 60",
          "legendFormat": "{{gen_ai_tool_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "expr": "sum by (gen_ai_tool_name) (rate(gen_ai_execute_tool_duration_seconds_count{error_type=\"tool_error\"}[$__rate_interval])) * 60",
          "legendFormat": "error · {{gen_ai_tool_name}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Llamadas al modelo que fallan, por tipo",
      "description": "LLMNoDisponibleException: un 429 o un 5xx (y contesta la reserva); cancelada: la persona se fue",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (gen_ai_request_model, error_type) (rate(gen_ai_client_inference_duration_seconds_count{error_type!=\"\"}[$__rate_interval])) * 60",
          "legendFormat": "{{gen_ai_request_model}} · {{error_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Métricas",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0
      }
    ]
  },
  "description": "El asistente (módulo 98): tokens, coste, tiempos, caché y tools, con las métricas GenAI de OpenTelemetry."
}
