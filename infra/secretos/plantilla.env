# infra/secretos/plantilla.env — la lista de secretos de UN entorno (módulo 86). Sin valores: es la plantilla.
#   cp infra/secretos/plantilla.env infra/secretos/staging.env   # rellénalo (y lo mismo para produccion.env)
#   sops encrypt -i infra/secretos/staging.env                    # cifrado ANTES del primer git add
#   sops edit infra/secretos/staging.env                          # para cambiarlo después (descifra en memoria)
# Sin comentarios al final de una línea con valor: SOPS los cifraría como parte del valor.
# Claves y contraseñas: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# ORIGEN_SECRETO: openssl rand -hex 32 (solo letras y cifras: va en una cabecera y en el Caddyfile)

# ── Django ──
DJANGO_SECRET_KEY=
# Al rotar la clave: la anterior aquí (separadas por comas) unos días; luego, vacío (runbook)
DJANGO_SECRET_KEY_FALLBACKS=
JWT_SIGNING_KEY=
# Módulo 90: la clave privada que firma los ID tokens. Una línea: uv run python manage.py generar_clave_oidc
OIDC_RSA_PRIVATE_KEY=

# ── PostgreSQL y RabbitMQ (la contraseña va dos veces: sola y dentro de la URL) ──
POSTGRES_PASSWORD=
DATABASE_URL=postgres://gastos:LA_MISMA_CONTRASEÑA@db:5432/gastos
RABBITMQ_PASSWORD=
CELERY_BROKER_URL=amqp://gastos:LA_MISMA_CONTRASEÑA@rabbitmq:5672//
ESTADISTICAS_DB_PASSWORD=

# ── Servicios externos ──
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Resend: una API key (re_…) con permiso "Sending access" solo para el dominio gastos.tudominio.com
SMTP_PASSWORD=
IA_API_KEY=
SENTRY_DSN=
GRAFANA_CLOUD_TOKEN=

# ── Solo staging (ejercicio 2 del módulo 86): la contraseña de TODOS los usuarios tras anonimizar ──
STAGING_PASSWORD=

# ── Vercel → Caddy: el mismo valor que la variable ORIGEN_SECRETO de Vercel para este entorno (Terraform) ──
ORIGEN_SECRETO=
